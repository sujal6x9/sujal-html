<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultra HD PDF to HTML Converter</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- PDF.js 2.16.105 for client-side rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    
    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .dropzone-active {
            border-color: #3b82f6 !important;
            background-color: #eff6ff !important;
            transform: scale(1.02);
        }
        .animate-stripes {
            background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.2) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0.2) 75%, transparent 75%, transparent);
            background-size: 1rem 1rem;
            animation: progress-stripes 1s linear infinite;
        }
        @keyframes progress-stripes {
            from { background-position: 1rem 0; }
            to { background-position: 0 0; }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-900 via-slate-800 to-black min-h-screen flex items-center justify-center p-4 text-gray-800 relative">

    <div class="max-w-xl w-full relative z-10">
        <div class="glass-panel rounded-3xl shadow-2xl p-8 md:p-12 transition-all duration-500">
            
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600 mb-4 shadow-sm border border-blue-100">
                    <i class="fa-solid fa-file-pdf text-3xl"></i>
                </div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">HD PDF Converter</h1>
                <p class="text-gray-500 mt-2 text-sm">Distortion-Free • Ultra HD Zoom</p>
            </div>

            <!-- Error Message Box -->
            <div id="errorBox" class="hidden mb-6 bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl flex items-center text-sm font-medium">
                <i class="fa-solid fa-circle-exclamation mr-3 text-red-500"></i>
                <span id="errorMessage">An error occurred.</span>
            </div>

            <!-- Upload View -->
            <div id="uploadView" class="block">
                <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-10 text-center cursor-pointer transition-all duration-300 hover:border-blue-500 hover:bg-slate-50 group">
                    <input type="file" id="fileInput" accept="application/pdf" class="hidden" />
                    
                    <i class="fa-solid fa-cloud-arrow-up text-4xl text-slate-400 group-hover:text-blue-500 transition-colors duration-300 mb-4 block"></i>
                    
                    <h3 class="text-lg font-bold text-slate-700 mb-1">Select a PDF</h3>
                    <p class="text-slate-500 text-sm mb-4">or drag and drop it here</p>
                    
                    <span class="inline-flex items-center px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full border border-blue-100">
                        <i class="fa-solid fa-microchip mr-1.5"></i> Client-Side Processing
                    </span>
                </div>
            </div>

            <!-- Progress View -->
            <div id="progressView" class="hidden py-6">
                <div class="text-center mb-6">
                    <i class="fa-solid fa-gear fa-spin text-3xl text-blue-500 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-1" id="statusTitle">Rendering High-Fidelity Pages...</h3>
                    <p class="text-gray-500 text-sm" id="statusSubtitle">Applying anti-stretch layout limits.</p>
                </div>

                <div class="w-full bg-slate-200 rounded-full h-4 overflow-hidden mb-2 shadow-inner">
                    <div id="progressBar" class="h-full bg-blue-600 animate-stripes transition-all duration-300 w-0"></div>
                </div>
                
                <div class="flex justify-between text-xs font-bold text-slate-500 uppercase tracking-wider">
                    <span id="pageCounter">Preparing...</span>
                    <span id="percentText">0%</span>
                </div>
            </div>

            <!-- Success View -->
            <div id="successView" class="hidden text-center py-6">
                <div class="w-20 h-20 mx-auto bg-green-50 rounded-full flex items-center justify-center mb-4 border border-green-100 shadow-sm">
                    <i class="fa-solid fa-check text-4xl text-green-500"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-2">Conversion Complete!</h3>
                <p class="text-gray-500 text-sm mb-6">Your anti-stretch, Ultra HD HTML file is downloading.</p>
                
                <button id="resetBtn" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-3 rounded-xl font-bold transition-colors border border-slate-200">
                    <i class="fa-solid fa-rotate-left mr-2"></i> Convert Another
                </button>
            </div>

        </div>
    </div>

    <!-- Hidden canvas used for high-res rendering -->
    <canvas id="renderCanvas" class="hidden"></canvas>

    <!-- Discreet Signature -->
    <div class="fixed bottom-4 right-6 text-white/30 text-sm font-semibold tracking-widest pointer-events-none select-none z-0">
        sujal
    </div>

    <script>
        // Set worker source for PDF.js
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

        // DOM Elements
        const uploadView = document.getElementById('uploadView');
        const progressView = document.getElementById('progressView');
        const successView = document.getElementById('successView');
        const errorBox = document.getElementById('errorBox');
        const errorMessage = document.getElementById('errorMessage');
        
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('fileInput');
        
        const progressBar = document.getElementById('progressBar');
        const percentText = document.getElementById('percentText');
        const pageCounter = document.getElementById('pageCounter');
        const statusTitle = document.getElementById('statusTitle');
        
        const resetBtn = document.getElementById('resetBtn');
        const renderCanvas = document.getElementById('renderCanvas');
        
        let originalFileName = "";

        // UI Helpers
        function showError(msg) {
            errorMessage.textContent = msg;
            errorBox.classList.remove('hidden');
            progressView.classList.add('hidden');
            uploadView.classList.remove('hidden');
        }

        function hideError() {
            errorBox.classList.add('hidden');
        }

        dropzone.addEventListener('click', () => {
            hideError();
            fileInput.click();
        });
        
        dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('dropzone-active');
        });
        
        dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('dropzone-active');
        });
        
        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            hideError();
            dropzone.classList.remove('dropzone-active');
            if (e.dataTransfer.files.length) {
                handleFile(e.dataTransfer.files[0]);
            }
        });
        
        fileInput.addEventListener('change', (e) => {
            hideError();
            if (e.target.files.length) {
                handleFile(e.target.files[0]);
            }
        });

        resetBtn.addEventListener('click', () => {
            successView.classList.add('hidden');
            progressView.classList.add('hidden');
            uploadView.classList.remove('hidden');
            fileInput.value = '';
            progressBar.style.width = '0%';
            percentText.textContent = '0%';
            hideError();
        });

        async function handleFile(file) {
            if (file.type !== 'application/pdf') {
                showError('Please upload a valid PDF document.');
                return;
            }

            originalFileName = file.name.replace(/\.[^/.]+$/, "");
            
            // Switch UI to Progress
            uploadView.classList.add('hidden');
            progressView.classList.remove('hidden');
            progressBar.style.width = '0%';
            percentText.textContent = '0%';
            
            try {
                const arrayBuffer = await file.arrayBuffer();
                await renderPdfToPureHtml(arrayBuffer);
            } catch (error) {
                console.error("Conversion Error:", error);
                showError("Failed to process PDF. It may be corrupted or password protected.");
                resetBtn.click();
            }
        }

        async function renderPdfToPureHtml(arrayBuffer) {
            const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            const numPages = pdf.numPages;
            const imageTags = [];
            
            const SCALE_ORIGINAL = 1.0;
            const SCALE_ULTRA_HD = 5.0; // Ultra HD resolution mapping
            const ctx = renderCanvas.getContext('2d', { alpha: false });

            // RECURSIVE FUNCTION to bypass 400ms loop protectors in web previews
            async function processPage(pageNum) {
                if (pageNum > numPages) return; // Finished all pages

                // Update Progress UI
                const percent = Math.round(((pageNum - 1) / numPages) * 100);
                progressBar.style.width = `${percent}%`;
                percentText.textContent = `${percent}%`;
                pageCounter.textContent = `Page ${pageNum} of ${numPages}`;
                
                const page = await pdf.getPage(pageNum);
                
                // 1. Get exact original unscaled dimensions
                const unscaledViewport = page.getViewport({ scale: SCALE_ORIGINAL });
                const originalWidth = unscaledViewport.width;
                
                // 2. Get high-res dimensions for internal rendering
                const hdViewport = page.getViewport({ scale: SCALE_ULTRA_HD });
                
                renderCanvas.width = hdViewport.width;
                renderCanvas.height = hdViewport.height;
                
                // Force white background for rendering
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, renderCanvas.width, renderCanvas.height);

                // Render page in high fidelity
                await page.render({
                    canvasContext: ctx,
                    viewport: hdViewport,
                    intent: 'print'
                }).promise;
                
                // Convert to data URL (PNG format for lossless high quality)
                const imgDataUrl = renderCanvas.toDataURL('image/png');
                
                // Outputs <section> and <img> matching your reference file layout
                const imageTag = `\n<section class="page" aria-label="Page ${pageNum}" style="width: min(100%, ${originalWidth}px);"><img src="${imgDataUrl}" alt="Page ${pageNum}" /></section>`;
                
                imageTags.push(imageTag);
                
                // Free memory
                page.cleanup();
                
                // Pause slightly to keep the browser UI responsive and bypass timeouts
                await new Promise(resolve => setTimeout(resolve, 50));

                // Process the next page
                await processPage(pageNum + 1);
            }

            // Start the recursive page processing at page 1
            await processPage(1);

            // Final Progress State
            progressBar.style.width = '100%';
            percentText.textContent = '100%';
            statusTitle.textContent = "Packaging Output...";
            pageCounter.textContent = "Complete";

            setTimeout(() => {
                triggerAutoDownload(imageTags);
            }, 300);
        }

        function triggerAutoDownload(imagesList) {
            // 1. Store the top half of the HTML
            const htmlHeader = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${originalFileName} - Converted from PDF</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #ececec; }
  body { font-family: Arial, Helvetica, sans-serif; }
  .document { width: 100%; padding: 24px 12px 48px; }
  .page {
    margin: 0 auto 24px;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0,0,0,.18);
    overflow: hidden;
  }
  .page img { display:block; width:100%; height:auto; }
  @media (max-width: 640px) {
    .document { padding: 0; }
    .page { width:100% !important; margin:0; box-shadow:none; }
  }
  @media print {
    @page { size: Letter portrait; margin: 0; }
    html, body { background:#fff; }
    .document { padding:0; }
    .page { width:100% !important; margin:0; box-shadow:none; page-break-after:always; break-after:page; }
    .page:last-child { page-break-after:auto; break-after:auto; }
  }
</style>
</head>
<body>
<main class="document" aria-label="Converted PDF document">\n`;

            // 2. Store the bottom half of the HTML
            const htmlFooter = `\n</main>\n</body>\n</html>`;

            // 3. Pass the array of chunks directly into the Blob to avoid V8 engine max string length limitations
            const blobParts = [htmlHeader, ...imagesList, htmlFooter];
            const blob = new Blob(blobParts, { type: 'text/html' });
            
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${originalFileName}.html`;
            
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            // Cleanup object URL
            setTimeout(() => URL.revokeObjectURL(url), 10000);

            // Update UI to success
            progressView.classList.add('hidden');
            successView.classList.remove('hidden');
        }
    </script>
</body>
</html>
